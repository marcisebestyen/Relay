# Relay configuration. Copy to .env for local dev; real env vars always win.
# An empty value means "use the default". Keep in sync with internal/config.

# Postgres connection string. Required.
RELAY_DATABASE_URL=

# API listen address.
RELAY_HTTP_ADDR=:8080
# Bearer token for the API. Empty disables auth.
RELAY_API_TOKEN=

# Comma-separated queues this worker polls.
RELAY_WORKER_QUEUES=default
RELAY_WORKER_CONCURRENCY=4
# A worker with no heartbeat for longer than this shows as stale.
RELAY_WORKER_STALE_AFTER=30s
# Must be shorter than the lease duration.
RELAY_HEARTBEAT_INTERVAL=10s
RELAY_LEASE_DURATION=30s

RELAY_DEFAULT_MAX_ATTEMPTS=3
RELAY_RETRY_BASE_DELAY=1s
RELAY_RETRY_MAX_DELAY=5m

# Default job timeout. 0 means none.
RELAY_DEFAULT_TIMEOUT=0
RELAY_CANCEL_GRACE_PERIOD=30s
RELAY_SHUTDOWN_TIMEOUT=30s

# Max request payload size in bytes (256 KiB).
RELAY_MAX_PAYLOAD_BYTES=262144

# debug, info, warn or error.
RELAY_LOG_LEVEL=info
